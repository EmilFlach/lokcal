    <!-- Onboarding -->
    <string name="onboarding_title">Lokcal</string>
    <string name="onboarding_tagline">A calorie tracker that is instant, uses real grocery data and respects your privacy</string>
    <string name="onboarding_body">Don\'t set a goal yet. Just track for four weeks to see how you actually eat. Learn the rhythm of weighing food at home and estimating while out.</string>
    <string name="onboarding_step1">Log everything. Even (especially) the bad days.</string>
    <string name="onboarding_step2">Weigh yourself daily. Do this for one month to find your baseline, then switch to weekly.</string>
    <string name="onboarding_step3">Review the data. After 4 weeks, your stats are complete enough to start making informed changes.</string>
    <string name="onboarding_start_tracking">Start Tracking</string>
    <string name="onboarding_footnote">A starting calorie goal was set for you. Adjust it anytime in Settings.</string>

